  "fixed_sql": [
    {
      "name": "recipe_search",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE VIRTUAL TABLE IF NOT EXISTS \"recipe_search\" USING fts5(recipe_id UNINDEXED, title, ingredients, tags, author, tokenize = 'unicode61 remove_diacritics 2');"
        }
      ]
    },
    {
      "name": "recipes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipes\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"base_servings\" REAL NOT NULL, \"servings_unit\" TEXT NOT NULL DEFAULT 'persone', \"prep_minutes\" INTEGER NULL, \"cook_minutes\" INTEGER NULL, \"rest_minutes\" INTEGER NULL, \"difficulty\" TEXT NULL, \"thumbnail_path\" TEXT NULL, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"extraction_model\" TEXT NULL, \"needs_review\" INTEGER NOT NULL DEFAULT 0 CHECK (\"needs_review\" IN (0, 1)), \"is_draft\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_draft\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recipe_search_delete",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER recipe_search_delete AFTER DELETE ON recipes BEGIN DELETE FROM recipe_search WHERE recipe_id = old.id;END"
        }
      ]
    },
    {
      "name": "recipe_sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipe_sources\" (\"recipe_id\" TEXT NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"platform\" TEXT NOT NULL, \"url\" TEXT NULL, \"source_key\" TEXT NULL UNIQUE, \"author_name\" TEXT NULL, \"caption\" TEXT NULL, \"transcript\" TEXT NULL, \"transcript_quality\" TEXT NOT NULL, PRIMARY KEY (\"recipe_id\"));"
        }
      ]
    },
    {
      "name": "ingredient_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ingredient_groups\" (\"id\" TEXT NOT NULL, \"recipe_id\" TEXT NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"name\" TEXT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "ingredients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ingredients\" (\"id\" TEXT NOT NULL, \"group_id\" TEXT NOT NULL REFERENCES ingredient_groups (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"quantity\" REAL NULL, \"quantity_max\" REAL NULL, \"unit\" TEXT NOT NULL, \"grams_estimate\" REAL NULL, \"is_estimated\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_estimated\" IN (0, 1)), \"note\" TEXT NULL, \"scaling_rule\" TEXT NOT NULL, \"scaling_exponent\" REAL NULL, \"canonical_name_en\" TEXT NULL, \"food_id\" INTEGER NULL, \"match_confidence\" REAL NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recipe_steps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipe_steps\" (\"id\" TEXT NOT NULL, \"recipe_id\" TEXT NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"number\" INTEGER NOT NULL, \"body\" TEXT NOT NULL, \"duration_minutes\" INTEGER NULL, \"temperature_c\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE);"
        }
      ]
    },
    {
      "name": "recipe_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipe_tags\" (\"recipe_id\" TEXT NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"tag_id\" INTEGER NOT NULL REFERENCES tags (id) ON DELETE CASCADE, PRIMARY KEY (\"recipe_id\", \"tag_id\"));"
        }
      ]
    },
    {
      "name": "nutrition_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"nutrition_snapshots\" (\"recipe_id\" TEXT NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"kcal\" REAL NOT NULL, \"protein_g\" REAL NOT NULL, \"carbs_g\" REAL NOT NULL, \"sugars_g\" REAL NOT NULL, \"fat_g\" REAL NOT NULL, \"saturated_fat_g\" REAL NOT NULL, \"fiber_g\" REAL NOT NULL, \"salt_g\" REAL NOT NULL, \"coverage\" REAL NOT NULL, \"computed_at\" TEXT NOT NULL, PRIMARY KEY (\"recipe_id\"));"
        }
      ]
    },
    {
      "name": "import_jobs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"import_jobs\" (\"id\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"shared_text\" TEXT NULL, \"shared_file_path\" TEXT NULL, \"platform\" TEXT NULL, \"source_url\" TEXT NULL, \"source_key\" TEXT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"failed_step\" TEXT NULL, \"error_code\" TEXT NULL, \"error_detail\" TEXT NULL, \"recipe_id\" TEXT NULL REFERENCES recipes (id) ON DELETE SET NULL, \"data\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "import_jobs_source_key",
